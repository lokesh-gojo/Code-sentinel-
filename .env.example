# -------------------------------------------------------------
# Automated Full-Stack Code Reviewer & Bug-Hunting Bot
# Environment Variables Configuration (.env)
# -------------------------------------------------------------

# Application Mode: 'development' | 'production'
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Google GenAI / Gemini API (Optional in dev; fallback mock supplied)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration (Optional in dev; fallback mock repository active)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# E2B Sandbox for Cloud Isolated Execution (Optional; local sandbox active)
E2B_API_KEY=

# GitHub App / Personal Access Token for PR scanning (Optional)
GITHUB_TOKEN=
